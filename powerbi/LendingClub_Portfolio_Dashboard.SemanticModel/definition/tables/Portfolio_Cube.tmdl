		summarizeBy: sum
		sourceColumn: seasoned_24m_count

	column default_24m_count
		dataType: int64
		isHidden
		lineageTag: b98b23db-ae63-4715-8a48-657489643adf
		summarizeBy: sum
		sourceColumn: default_24m_count

	column seasoned_36m_count
		dataType: int64
