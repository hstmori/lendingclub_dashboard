/// Aggregated LendingClub portfolio cube prepared in Jupyter. Contains only analysis-ready fields; no raw accepted-loans table.
table Portfolio_Cube
	lineageTag: 110e2ed8-5d1b-4a52-9600-8204452e1d95

	measure 'Total Loans' = SUM ( Portfolio_Cube[loan_count] )
		formatString: #,0
		displayFolder: KPI
		lineageTag: 857edaf2-6d46-4b6d-ad95-e2ed711b0007

	measure 'Total Funded Amount' = SUM ( Portfolio_Cube[funded_amount] )
		formatString: \$#,0
		displayFolder: KPI
		lineageTag: c98cdabd-067d-43b4-950e-e2914ba9d9b7

	measure 'Average Loan Amount' = DIVIDE ( [Total Funded Amount], [Total Loans] )
		formatString: \$#,0
		displayFolder: KPI
		lineageTag: ab231626-fa82-4857-8f1d-4a89dad8e536

	measure 'Weighted APR' = DIVIDE ( SUM ( Portfolio_Cube[funded_x_apr] ), [Total Funded Amount] )
		formatString: 0.00%
		displayFolder: KPI
		lineageTag: 3362de56-d7ac-4ea1-a548-c69f71773edd

	/// PD: Default/Charged Off trên số khoản vay đã có outcome cuối cùng.
	measure 'Matured Default Rate' = DIVIDE ( SUM ( Portfolio_Cube[default_count] ), SUM ( Portfolio_Cube[matured_count] ) )
		formatString: 0.00%
		displayFolder: Risk
		lineageTag: b4419f17-efa7-443c-97d7-af3afa2b24fd

	/// Tổn thất ròng sau recoveries trên exposure của các khoản default.
	measure 'LGD Proxy' = DIVIDE ( SUM ( Portfolio_Cube[net_loss_proxy] ), SUM ( Portfolio_Cube[default_exposure_proxy] ) )
		formatString: 0.00%
		displayFolder: Risk
		lineageTag: 8dcb1a08-7eb6-4997-a40f-dc0cb6d3cac2

	measure 'Expected Loss Rate Proxy' = [Matured Default Rate] * [LGD Proxy]
		formatString: 0.00%
		displayFolder: Risk
		lineageTag: cb83cd0a-92e0-4e45-9cfb-0512026b4a05

	/// PD × LGD × EAD, với funded amount đại diện EAD.
	measure 'Expected Loss Proxy' = [Expected Loss Rate Proxy] * [Total Funded Amount]
		formatString: \$#,0
		displayFolder: Risk
		lineageTag: 97606932-8f67-45ac-8ea7-89b133e66fa2

	measure 'Funding Cost Value' = SELECTEDVALUE ( 'Funding Cost'[Funding Cost Rate], 0.04 )
		formatString: 0.0%
		displayFolder: Profitability
		lineageTag: bd908ea0-1122-41f2-b4f9-ef10b9eae065

	measure 'Operating Cost Value' = SELECTEDVALUE ( 'Operating Cost'[Operating Cost Rate], 0.01 )
		formatString: 0.0%
		displayFolder: Profitability
		lineageTag: 3c6c6054-8274-419f-b887-e402718f3df6

	/// Lãi đóng góp mỗi năm trên dư nợ bình quân: (lãi đã thu − tổn thất ròng − chi phí vốn − chi phí vận hành) / balance-years.
	measure 'Risk-Adjusted Contribution Rate Proxy' = DIVIDE ( [Contribution Amount], [Balance-Years Proxy] )
		formatString: 0.00%
		displayFolder: Profitability
		lineageTag: 3f1deb10-67dd-457d-b5d5-1d4795327b9c

	/// Tỷ lệ vỡ nợ trong 12 tháng đầu, chỉ tính khoản vay đã giải ngân đủ 12 tháng trước ngày chốt dữ liệu.
	measure 'Default Rate 12M' = DIVIDE ( SUM ( Portfolio_Cube[default_12m_count] ), SUM ( Portfolio_Cube[seasoned_12m_count] ) )
		formatString: 0.00%
		displayFolder: Vintage Quality
		lineageTag: 05c1684e-dbeb-4012-a241-e72a1b7da24f

	measure 'Default Rate 24M' = DIVIDE ( SUM ( Portfolio_Cube[default_24m_count] ), SUM ( Portfolio_Cube[seasoned_24m_count] ) )
		formatString: 0.00%
		displayFolder: Vintage Quality
		lineageTag: 0fed160b-9f58-4072-aa1e-f819cadca96e

	measure 'Default Rate 36M' = DIVIDE ( SUM ( Portfolio_Cube[default_36m_count] ), SUM ( Portfolio_Cube[seasoned_36m_count] ) )
		formatString: 0.00%
		displayFolder: Vintage Quality
		lineageTag: 9737f5a9-d4c3-448f-a338-7db55de588d7

	measure 'Active Loans' = SUM ( Portfolio_Cube[current_count] ) + SUM ( Portfolio_Cube[late_count] )
		formatString: #,0
		displayFolder: Vintage Quality
		lineageTag: 34635890-882f-4d9c-a80f-c6f1a4da6063

	/// Tỷ lệ khoản đang trả bị trễ hạn (In Grace / Late); tín hiệu sớm cho vintage còn non.
	measure 'Current Delinquency Rate' = DIVIDE ( SUM ( Portfolio_Cube[late_count] ), [Active Loans] )
		formatString: 0.00%
		displayFolder: Vintage Quality
		lineageTag: 9de4c571-77f0-4189-8288-9d2be4f0301a

	/// Tỷ lệ khoản trả hết sớm (≥ 3 tháng trước kỳ hạn) trong 24 tháng đầu, trên khoản đã giải ngân đủ 24 tháng; so sánh được giữa các vintage.
	measure 'Prepayment Rate 24M' = DIVIDE ( SUM ( Portfolio_Cube[prepaid_24m_count] ), SUM ( Portfolio_Cube[seasoned_24m_count] ) )
		formatString: 0.0%
		displayFolder: Vintage Quality
		lineageTag: f7f5498e-4032-43bd-91cf-f3d94c463f8f

	/// Tỷ lệ khoản vỡ nợ có thoả thuận debt settlement.
	measure 'Settlement Rate' = DIVIDE ( SUM ( Portfolio_Cube[settlement_count] ), SUM ( Portfolio_Cube[default_count] ) )
		formatString: 0.0%
		displayFolder: Vintage Quality
		lineageTag: 65e30beb-ee7f-4a1d-aa36-c33c3edaf547

	/// Recovery sau khi trừ phí thu hồi nợ.
	measure 'Net Recovery Rate' = DIVIDE ( [Recoveries Amount] - SUM ( Portfolio_Cube[collection_fee_default] ), SUM ( Portfolio_Cube[default_exposure_proxy] ) )
		formatString: 0.0%
		displayFolder: Risk
		lineageTag: 303e420b-5f10-4b39-b985-50fea7591e6b

	measure 'Matured Balance-Years Proxy' =
			SUMX (
			    Portfolio_Cube,
			    DIVIDE ( Portfolio_Cube[matured_interest] * Portfolio_Cube[matured_funded], Portfolio_Cube[matured_funded_x_apr] )
			)
		formatString: \$#,0
		isHidden
		displayFolder: Vintage Quality
		lineageTag: dc956b25-6b06-40c8-9d12-c8139843cf55

	/// Contribution chỉ trên các khoản đã có outcome cuối (Net Credit Loss vốn chỉ phát sinh ở khoản default, đều là matured).
	measure 'Matured Contribution Amount' = SUM ( Portfolio_Cube[matured_interest] ) - [Net Credit Loss] - [Matured Balance-Years Proxy] * ( [Funding Cost Value] + [Operating Cost Value] )
		formatString: \$#,0
		displayFolder: Vintage Quality
		lineageTag: 4e8d385b-a6ef-4878-8de3-c43a38f381b9

	/// Cận dưới: chỉ tính khoản đã đóng. Với vintage non, khoản đã đóng phần lớn là vỡ nợ sớm nên con số bi quan; Contribution Margin là cận trên. Hai số hội tụ khi vintage chín.
	measure 'Matured Contribution Margin' = DIVIDE ( [Matured Contribution Amount], SUM ( Portfolio_Cube[matured_funded] ) )
		formatString: 0.00%
		displayFolder: Vintage Quality
		lineageTag: b491ff4c-1e27-4688-bb56-aa963d8f68b5

	/// Giá trị mỗi bước trên 100 USD giải ngân (cùng cơ sở với các card USD); bước Contribution để trống vì waterfall tự vẽ cột Total.
	measure 'Contribution Bridge Value' =
			VAR _step = SELECTEDVALUE ( 'Contribution Bridge'[Bridge Step] )
			VAR _funded = [Total Funded Amount]
			RETURN
			    SWITCH (
			        _step,
			        "Gross interest", DIVIDE ( [Gross Interest], _funded ) * 100,
			        "Net credit loss", - DIVIDE ( [Net Credit Loss], _funded ) * 100,
			        "Funding cost", - DIVIDE ( [Funding Cost Amount], _funded ) * 100,
			        "Operating cost", - DIVIDE ( [Operating Cost Amount], _funded ) * 100
			    )
		formatString: #,0.00
		displayFolder: Profitability
		lineageTag: 5a1cacb4-bcf7-4a14-a4cb-6283392f707d

	measure Recommendation =
			VAR _contrib = [Risk-Adjusted Contribution Rate Proxy]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _contrib ), BLANK (),
			        NOT [Is Reliable Segment], "Chưa đủ dữ liệu",
			        _contrib < 0, "Thắt chặt / dừng",
			        _contrib < 0.02, "Theo dõi, định giá lại",
			        "Duy trì / mở rộng"
			    )
		displayFolder: Profitability
		lineageTag: a5abf0f2-a860-4453-9652-7ee8a230a80c

	/// Lãi thực thu đến ngày dữ liệu (total_rec_int).
	measure 'Gross Interest' = SUM ( Portfolio_Cube[realized_interest] )
		formatString: \$#,0
		displayFolder: Profitability
		lineageTag: 6abcb481-ee4b-4c07-82c0-d739672eb22a

	/// Tổn thất ròng sau recoveries đã phát sinh trên các khoản default.
	measure 'Net Credit Loss' = SUM ( Portfolio_Cube[net_loss_proxy] )
		formatString: \$#,0
		displayFolder: Profitability
		lineageTag: d3dba0b7-f390-4791-84a8-8471a25ba3d7

	measure 'Recoveries Amount' = SUM ( Portfolio_Cube[recoveries_default] )
		formatString: \$#,0
		displayFolder: Risk
		lineageTag: 6cfcf738-286d-46f7-8702-9938fe164016

	measure 'Recovery Rate Proxy' = DIVIDE ( [Recoveries Amount], SUM ( Portfolio_Cube[default_exposure_proxy] ) )
		formatString: 0.0%
		displayFolder: Risk
		lineageTag: fe6d1586-88df-4e1b-9f3f-c672ad57c999

	/// Tỷ lệ khoản vay đã có outcome cuối; thấp nghĩa là PD của vintage đó chưa đáng tin.
	measure 'Maturity Coverage' = DIVIDE ( SUM ( Portfolio_Cube[matured_count] ), [Total Loans] )
		formatString: 0.0%
		displayFolder: Risk
		lineageTag: fca8fe1d-aaf8-4467-8ed8-846f58aed9d8

	/// Dư nợ bình quân × số năm, suy ra từ lãi đã thu / APR của từng dòng; dùng làm cơ sở tính chi phí vốn và vận hành.
	measure 'Balance-Years Proxy' =
			SUMX (
			    Portfolio_Cube,
			    DIVIDE ( Portfolio_Cube[realized_interest] * Portfolio_Cube[funded_amount], Portfolio_Cube[funded_x_apr] )
			)
		formatString: \$#,0
		isHidden
		displayFolder: Profitability
		lineageTag: 8a08a867-12aa-46b7-9f90-ec854219913a

	measure 'Funding Cost Amount' = [Balance-Years Proxy] * [Funding Cost Value]
		formatString: \$#,0
		displayFolder: Profitability
		lineageTag: b645b5d3-7bed-4f6b-aee2-63c531932203

	measure 'Operating Cost Amount' = [Balance-Years Proxy] * [Operating Cost Value]
		formatString: \$#,0
		displayFolder: Profitability
		lineageTag: 4674eae9-6ce2-40f5-9be4-94e937ecba2e

	measure 'Contribution Amount' = [Gross Interest] - [Net Credit Loss] - [Funding Cost Amount] - [Operating Cost Amount]
		formatString: \$#,0
		displayFolder: Profitability
		lineageTag: b39391b9-e898-4a46-9103-3716105c0949

	/// Lãi đóng góp trên tổng số tiền giải ngân (toàn vòng đời đến ngày dữ liệu).
	measure 'Contribution Margin' = DIVIDE ( [Contribution Amount], [Total Funded Amount] )
		formatString: 0.00%
		displayFolder: Profitability
		lineageTag: 1f036774-c560-491d-994f-b3a30e6a477f

	measure 'Matured Loans' = SUM ( Portfolio_Cube[matured_count] )
		formatString: #,0
		displayFolder: Risk
		lineageTag: a1bd77eb-f244-47f8-9ffc-1e7c2c18ed6e

	/// Tổn thất ròng mỗi năm trên dư nợ bình quân (cùng cơ sở với Contribution Rate).
	measure 'Annualized Net Loss Rate' = DIVIDE ( [Net Credit Loss], [Balance-Years Proxy] )
		formatString: 0.00%
		displayFolder: Risk
		lineageTag: 9039a331-b2f6-4d4f-90df-c10cb0c4f7cc

	/// APR tối thiểu để hoà vốn: tổn thất ròng/năm + chi phí vốn + chi phí vận hành.
	measure 'Break-even APR' = [Annualized Net Loss Rate] + [Funding Cost Value] + [Operating Cost Value]
		formatString: 0.00%
		displayFolder: Profitability
		lineageTag: a5643401-b848-411a-b9b4-188ee61eab6b

	measure 'Share of Funded' = DIVIDE ( [Total Funded Amount], CALCULATE ( [Total Funded Amount], ALLSELECTED ( Portfolio_Cube ) ) )
		formatString: 0.00%
		displayFolder: Action
		lineageTag: 1852278c-6a68-4305-8714-ae3c546d429d

	/// PD của phân khúc so với PD bình quân của phần đang chọn; > 1 là rủi ro hơn bình quân.
	measure 'Risk Index' = DIVIDE ( [Matured Default Rate], CALCULATE ( [Matured Default Rate], ALLSELECTED ( Portfolio_Cube ) ) )
		formatString: 0.00
		displayFolder: Action
		lineageTag: ce6b6442-cf45-491e-a59c-420169c128ad

	/// Đủ dữ liệu để kết luận: ít nhất 200 khoản đã có outcome và coverage từ 60%.
	measure 'Is Reliable Segment' = [Matured Loans] >= 200 && [Maturity Coverage] >= 0.6
		isHidden
		displayFolder: Action
		lineageTag: 9a0527ce-5d4c-4394-8de9-e87b6fbd45e3

	/// Số phân khúc (Grade × Term × Purpose × FICO × DTI) đủ dữ liệu và đang lỗ.
	measure 'Loss Segments Count' =
			VAR _seg =
			    ADDCOLUMNS (
			        SUMMARIZE (
			            Portfolio_Cube,
			            Portfolio_Cube[grade], Portfolio_Cube[term], Portfolio_Cube[purpose],
			            Portfolio_Cube[fico_band], Portfolio_Cube[dti_band]
			        ),
			        "@contrib", [Contribution Amount],
			        "@rate", [Risk-Adjusted Contribution Rate Proxy],
			        "@funded", [Total Funded Amount],
			        "@reliable", [Is Reliable Segment]
			    )
			RETURN
			    COUNTROWS ( FILTER ( _seg, [@reliable] && [@rate] < 0 ) ) + 0
		formatString: #,0
		displayFolder: Action
		lineageTag: 87ba1fc3-4d09-4c51-9b73-7a343ba0fdbe

	/// Số tiền giải ngân nằm ở các phân khúc lỗ.
	measure 'Funded in Loss Segments' =
			VAR _seg =
			    ADDCOLUMNS (
			        SUMMARIZE (
			            Portfolio_Cube,
			            Portfolio_Cube[grade], Portfolio_Cube[term], Portfolio_Cube[purpose],
			            Portfolio_Cube[fico_band], Portfolio_Cube[dti_band]
			        ),
			        "@contrib", [Contribution Amount],
			        "@rate", [Risk-Adjusted Contribution Rate Proxy],
			        "@funded", [Total Funded Amount],
			        "@reliable", [Is Reliable Segment]
			    )
			RETURN
			    SUMX ( FILTER ( _seg, [@reliable] && [@rate] < 0 ), [@funded] )
		formatString: \$#,0
		displayFolder: Action
		lineageTag: 5819c451-d55f-496e-b506-49fe0ed7b9ef

	measure 'Funded in Loss Segments %' = DIVIDE ( [Funded in Loss Segments], [Total Funded Amount] )
		formatString: 0.0%
		displayFolder: Action
		lineageTag: 6c8ba90c-31b5-4c40-9928-46abac4c5350

	/// Tổng Contribution âm của các phân khúc lỗ.
	measure 'Loss from Loss Segments' =
			VAR _seg =
			    ADDCOLUMNS (
			        SUMMARIZE (
			            Portfolio_Cube,
			            Portfolio_Cube[grade], Portfolio_Cube[term], Portfolio_Cube[purpose],
			            Portfolio_Cube[fico_band], Portfolio_Cube[dti_band]
			        ),
			        "@contrib", [Contribution Amount],
			        "@rate", [Risk-Adjusted Contribution Rate Proxy],
			        "@funded", [Total Funded Amount],
			        "@reliable", [Is Reliable Segment]
			    )
			RETURN
			    SUMX ( FILTER ( _seg, [@reliable] && [@rate] < 0 ), [@contrib] )
		formatString: \$#,0
		displayFolder: Action
		lineageTag: d5ee6430-96fe-4dea-bb08-3384f1c41c90

	/// Contribution ước tính nếu dừng các phân khúc lỗ (chưa tính chi phí cố định không giảm).
	measure 'Pro-forma Contribution' = [Contribution Amount] - [Loss from Loss Segments]
		formatString: \$#,0
		displayFolder: Action
		lineageTag: 3565fff3-362f-4fc2-bb45-3f7d787ae38b

	/// Tỷ lệ funded nằm ở phân khúc chưa đủ dữ liệu để kết luận.
	measure 'Funded Low Confidence %' =
			VAR _seg =
			    ADDCOLUMNS (
			        SUMMARIZE (
			            Portfolio_Cube,
			            Portfolio_Cube[grade], Portfolio_Cube[term], Portfolio_Cube[purpose],
			            Portfolio_Cube[fico_band], Portfolio_Cube[dti_band]
			        ),
			        "@contrib", [Contribution Amount],
			        "@rate", [Risk-Adjusted Contribution Rate Proxy],
			        "@funded", [Total Funded Amount],
			        "@reliable", [Is Reliable Segment]
			    )
			RETURN
			    DIVIDE ( SUMX ( FILTER ( _seg, NOT [@reliable] ), [@funded] ), [Total Funded Amount] )
		formatString: 0.0%
		displayFolder: Action
		lineageTag: 187fc7bd-309e-4e13-bf93-d274df317bb9

	column vintage_year
		dataType: int64
		formatString: 0
		lineageTag: 5c8dbb3c-ca5a-4346-bda6-823fdd10edd2
		summarizeBy: none
		sourceColumn: vintage_year

	column grade
		dataType: string
		lineageTag: c13092ef-4a3d-4bea-8edd-c7fa49b9d12c
